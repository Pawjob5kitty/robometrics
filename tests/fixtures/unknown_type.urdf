<?xml version="1.0"?>
<!-- An unknown joint type. 'screw' does not exist in URDF, and would not fit
     this library anyway: it couples rotation and translation to one scalar in a
     way prismatic does not. -->
<robot name="unknown_type">
  <link name="base"/>
  <link name="link1"/>

  <joint name="joint1" type="screw">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5" upper="1.5" effort="87" velocity="2.61"/>
  </joint>
</robot>
