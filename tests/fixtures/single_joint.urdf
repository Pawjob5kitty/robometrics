<?xml version="1.0"?>
<!-- One revolute joint about z at height 0.1, followed by a fixed 0.5 arm
     along x. The arm matters: if the tip sat ON the axis of rotation, the
     rotation would not show in its position and the test would pass for R = I.

     The expected tip values are hand-computed in test_kinematics.cpp. -->
<robot name="single_joint">
  <link name="base"/>
  <link name="arm"/>
  <link name="tip"/>

  <joint name="j" type="revolute">
    <parent link="base"/>
    <child link="arm"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.15" upper="3.15" effort="10" velocity="1"/>
  </joint>

  <joint name="arm_fixed" type="fixed">
    <parent link="arm"/>
    <child link="tip"/>
    <origin xyz="0.5 0 0" rpy="0 0 0"/>
  </joint>
</robot>
