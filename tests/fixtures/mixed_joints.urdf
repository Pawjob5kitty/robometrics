<?xml version="1.0"?>
<!-- The smallest robot that mixes joint kinds: one prismatic (metres) then one
     revolute (radians). ||dq|| over these adds metres and radians into one sum,
     which is why pathEfficiency reports MixedJointTypes for it. dexterity is
     still well defined and must keep working. -->
<robot name="mixed_joints">
  <link name="base"/>
  <link name="a"/>
  <link name="b"/>

  <joint name="slide" type="prismatic">
    <parent link="base"/><child link="a"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1" effort="1" velocity="1"/>
  </joint>

  <joint name="turn" type="revolute">
    <parent link="a"/><child link="b"/>
    <origin xyz="0.3 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3" upper="3" effort="1" velocity="1"/>
  </joint>
</robot>
