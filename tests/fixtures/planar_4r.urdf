<?xml version="1.0"?>
<!-- Planar 4R arm: four parallel z axes, links of 4 x 0.3.

     THIS is the fixture that is genuinely redundant with respect to
     pathEfficiency, and the reason is worth reading.

     A planar arm drives only three of the six twist components: vx, vy,
     omega_z. The other three are structurally zero, so rank(J) never exceeds 3
     however many joints it has. Redundancy means numDofs > rank(J), so a
     planar arm needs AT LEAST FOUR joints.

     The three-joint arm (planar_3r) has rank 3 with 3 columns, so a null space
     of dimension 0 and a unique solution, and efficiency is always exactly 1.
     The four-joint arm has a null space of dimension 1: there is a direction in
     joint space along which the joints move and the tip does not. -->
<robot name="planar_4r">
  <link name="base"/>
  <link name="link1"/>
  <link name="link2"/>
  <link name="link3"/>
  <link name="link4"/>
  <link name="tip"/>

  <joint name="j1" type="revolute">
    <parent link="base"/><child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
  </joint>

  <joint name="j2" type="revolute">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0.3 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
  </joint>

  <joint name="j3" type="revolute">
    <parent link="link2"/><child link="link3"/>
    <origin xyz="0.3 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
  </joint>

  <joint name="j4" type="revolute">
    <parent link="link3"/><child link="link4"/>
    <origin xyz="0.3 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
  </joint>

  <joint name="tip_fixed" type="fixed">
    <parent link="link4"/><child link="tip"/>
    <origin xyz="0.3 0 0" rpy="0 0 0"/>
  </joint>
</robot>
