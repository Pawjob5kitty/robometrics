<?xml version="1.0"?>
<!-- Tvar, ktery ma kazdy realny manipulator s chapadlem:

       base  [arm revolute]>  hand  [finger_left  prismatic]>  left
                                    [finger_right prismatic, mimic]>  right

     (V XML komentari nesmi byt dve pomlcky za sebou, takze sipky jsou
     zkracene. Neni to preklep.)

     Dve veci, ktere se tim testuji:
       1. dva listy (left, right) znamenaji, ze autodetekce tipu musi selhat
          s vypisem kandidatu, ne hadat
       2. finger_right ma mimic, takze se pocita mezi numJoints(), ale ne do
          numDofs(); q ma delku 2, ne 3

     multiplier je nastaveny na minus jedna: prsty jedou proti sobe. -->
<robot name="mimic_gripper">
  <link name="base"/>
  <link name="hand"/>
  <link name="left"/>
  <link name="right"/>

  <joint name="arm" type="revolute">
    <parent link="base"/>
    <child link="hand"/>
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3" upper="3" effort="87" velocity="2.61"/>
  </joint>

  <joint name="finger_left" type="prismatic">
    <parent link="hand"/>
    <child link="left"/>
    <origin xyz="0 0.02 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.04" effort="20" velocity="0.2"/>
  </joint>

  <joint name="finger_right" type="prismatic">
    <parent link="hand"/>
    <child link="right"/>
    <origin xyz="0 -0.02 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.04" upper="0" effort="20" velocity="0.2"/>
    <mimic joint="finger_left" multiplier="-1" offset="0"/>
  </joint>
</robot>
