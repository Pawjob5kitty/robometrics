<?xml version="1.0"?>
<!-- The shape every real manipulator with a gripper has:

       base  [arm revolute]>  hand  [finger_left  prismatic]>  left
                                    [finger_right prismatic, mimic]>  right

     (An XML comment may not contain two consecutive hyphens, so the arrows
     above are shortened. Not a typo.)

     Two things this exercises:
       1. two leaves (left, right), so tip auto-detection must fail and list
          the candidates rather than guess
       2. finger_right has a mimic, so it counts towards numJoints() but not
          numDofs(); q has length 2, not 3

     multiplier is minus one: the fingers move against each other. -->
<robot name="mimic_gripper">
  <link name="base"/>
  <link name="hand"/>
  <link name="left"/>
  <link name="right"/>

  <joint name="arm" type="revolute">
    <parent link="base"/>
    <child link="hand"/>
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3" upper="3" effort="87" velocity="2.61"/>
  </joint>

  <joint name="finger_left" type="prismatic">
    <parent link="hand"/>
    <child link="left"/>
    <origin xyz="0 0.02 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.04" effort="20" velocity="0.2"/>
  </joint>

  <joint name="finger_right" type="prismatic">
    <parent link="hand"/>
    <child link="right"/>
    <origin xyz="0 -0.02 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.04" upper="0" effort="20" velocity="0.2"/>
    <mimic joint="finger_left" multiplier="-1" offset="0"/>
  </joint>
</robot>
